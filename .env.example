APP_ENV=production
APP_DEBUG=0
APP_URL=http://localhost:8080

# Compte admin seed (première install uniquement — ne pas y mettre un hash de prod réel)
ADMIN_EMAIL=admin@mecmpackagingmanager.com
ADMIN_DISPLAY_NAME=admin
# Hash bcrypt public démo (= mot de passe admin@mecmpackagingmanager.com).
# Générer le vôtre : php -r "echo password_hash('VotreMdp', PASSWORD_DEFAULT), PHP_EOL;"
# ADMIN_PASSWORD_HASH=

APP_PUBLISH_PORT=8080
SSH_PUBLISH_PORT=2222
ENABLE_SSH=1
SSH_USER=admin
# Mot de passe SSH lab du conteneur (défaut simple — changez en prod)
SSH_PASSWORD=admin

# Rappels renouvellement (cron dans le conteneur)
ENABLE_RENEWAL_CRON=1
RENEWAL_MAIL_CRON=0 8 * * *

# Projet monté en entier (.:/var/www/html). Données runtime :
# HOST_DATA_ROOT=./docker-data

# Défauts VM (placeholders) — chaque user configure sa VM dans l’UI (/account/vm)
TEST_VM_HOST=192.168.1.1
TEST_VM_PORT=22
TEST_VM_USER=admin
TEST_VM_PASSWORD=admin
